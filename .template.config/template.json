{
  "$schema": "https://json.schemastore.org/template",
  "author": "n4sser77",
  "classifications": [
    "Web",
    "Blazor",
    "Tailwind",
    "Identity"
  ],
  "identity": "BlazorTailwind.Template",
  "name": "Blazor Web App with Tailwind CSS",
  "defaultName": "BlazorApp",
  "description": "A Blazor Server project template pre-configured with Tailwind CSS v4 and ASP.NET Core Identity with SQL Server.",
  "shortName": "blazortailwind",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "BlazorWebAppTailwind",
  "preferNameDirectory": true,
  "guids": [
    "17bba011-adc5-4801-971e-6f683ceaf100"
  ],
  "primaryOutputs": [
    {
      "path": "BlazorWebAppTailwind.csproj"
    }
  ],
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "displayName": {
      "type": "parameter",
      "datatype": "text",
      "description": "The display name for the application shown in the navigation menu.",
      "defaultValue": "BlazorApp",
      "replaces": "BlazorTailwind"
    },
    "npmName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "blazorwebapptailwind"
    },
    "httpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      },
      "replaces": "5282"
    },
    "httpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      },
      "replaces": "7059"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    }
  },
  "sources": [
    {
      "source": "Content",
      "target": "./",
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".template.config/**",
            ".vs/**",
            ".vscode/**",
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/*.user",
            "**/*.lock.json",
            "**/.gitignore"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
